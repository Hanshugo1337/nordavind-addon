{
  "name": "nordavind-companion",
  "version": "3.2.0",
  "description": "NordavindLC Companion — Electron tray app that syncs loot council scoring with nordavind.cc",
  "author": "Nordavind",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "cc.nordavind.companion",
    "productName": "NordavindLC Companion",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NordavindLC Companion",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hanshugo1337",
        "repo": "nordavind-addon"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "wizard.js",
      "wizard-preload.js",
      "wizard.html",
      "lib/**",
      "renderer/**",
      "public/**"
    ]
  }
}
